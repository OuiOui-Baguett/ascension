{
  "name": "naufrages",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:server": "npm run build:server && PORT=8787 node dist-server/index.mjs",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "build:solo": "VITE_SOLO=1 vite build",
    "start": "node dist-server/index.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.1.0",
    "postprocessing": "^6.36.4",
    "three": "^0.169.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "engines": { "node": ">=18" }
}
