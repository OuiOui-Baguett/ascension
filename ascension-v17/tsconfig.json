{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": ["node", "vite/client"]
  },
  "include": ["shared/**/*.ts", "client/src/**/*.ts", "server/src/**/*.ts"]
}
